# Copy to .env on the server (never committed — see .gitignore).
# Generate values with: openssl rand -hex 32

# Manual trigger: https://<domain>/deploy.php?token=<value>
# Comma-separated to allow more than one token.
DEPLOY_TOKEN=

# Optional. Set the same value as the GitHub webhook secret to enable
# automatic deploys on push. Leave empty to allow manual triggers only.
GITHUB_WEBHOOK_SECRET=
